# AIDIL STORE production environment template
# Never put real secrets in this file.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
PAKASIR_PROJECT=YOUR_PAKASIR_PROJECT
PAKASIR_API_KEY=YOUR_PAKASIR_API_KEY
PAKASIR_SANDBOX=false
DIGIFLAZZ_USERNAME=YOUR_DIGIFLAZZ_USERNAME
DIGIFLAZZ_API_KEY=YOUR_DIGIFLAZZ_API_KEY
DIGIFLAZZ_TEST=false
DIGIFLAZZ_WEBHOOK_SECRET=YOUR_DIGIFLAZZ_WEBHOOK_SECRET
INTERNAL_CRON_SECRET=YOUR_INTERNAL_CRON_SECRET
CRON_SECRET=YOUR_CRON_SECRET
# Push notification (optional until push delivery is enabled)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:YOUR_EMAIL

# Registration OTP + Admin 2FA signing secret (required in production, one secret is reused for both)
OTP_PEPPER=replace-with-a-long-random-secret

# Email OTP (production)
RESEND_API_KEY=ISI_RESEND_API_KEY
EMAIL_FROM=AIDIL STORE <noreply@domain-kamu>

# Identitas resmi pelaku usaha — WAJIB diisi sebelum platform dipakai publik.
# Ditampilkan di footer, /identitas-usaha, /terms, /privacy sesuai kewajiban
# keterbukaan identitas PSE (PP 71/2019, Permendag 50/2020).
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=Nama PT/CV/Usaha Perorangan Kamu
NEXT_PUBLIC_BUSINESS_ENTITY_TYPE=Perorangan / CV / PT (isi sesuai badan usaha)
NEXT_PUBLIC_BUSINESS_NIB=ISI_NOMOR_NIB
NEXT_PUBLIC_BUSINESS_ADDRESS=Alamat lengkap usaha sesuai NIB
NEXT_PUBLIC_BUSINESS_EMAIL=official@domain-kamu
NEXT_PUBLIC_BUSINESS_PHONE=08xxxxxxxxxx
# NOT_SET | PENDING | REGISTERED
NEXT_PUBLIC_PSE_STATUS=NOT_SET
NEXT_PUBLIC_PSE_NUMBER=

# Error monitoring (Sentry). Kosongkan SENTRY_DSN/NEXT_PUBLIC_SENTRY_DSN untuk
# menonaktifkan Sentry sepenuhnya (aman dipakai di dev tanpa akun Sentry).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
